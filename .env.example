# Liread - Supabase Configuration
# Obtain your project URL and public Anon Key from: https://app.supabase.com/project/_/settings/api
# These credentials are required for real accounts. Without them only Guest mode works.

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe to use in browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# LiRead Telegram Bot (Frontend)
VITE_TELEGRAM_BOT_USERNAME=lireadbooksbot
VITE_TELEGRAM_BOT_URL=https://t.me/lireadbooksbot

# LiRead Telegram Webhook (/api/telegram Serverless Environment Variables)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=8596590594
TELEGRAM_VAULT_CHANNEL_ID=3684646430
